NODE_ENV=production
PORT=3000
# In Docker auf das gemountete Volume zeigen lassen:
DATABASE_PATH=/data/eazio.db
# 32-Byte-Key, base64: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
MASTER_KEY=
# zufälliger String, min. 16 Zeichen: `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
SESSION_SECRET=
# Token zum einmaligen Anlegen von Nutzern (POST /api/auth/bootstrap)
ADMIN_BOOTSTRAP=
TZ=Europe/Berlin
# Hinter Nginx Proxy Manager (HTTPS) korrekt:
COOKIE_SECURE=true
YAZIO_COUNTRIES=DE
YAZIO_LOCALES=de_DE,de_US
# Host-Port, auf den Nginx Proxy Manager weiterleitet (http://<host-ip>:PORT):
EAZIO_PORT=8413
# Claude API key für den Rezept-Import (LLM-Zutaten-Extraktion). Optional –
# ohne ihn ist nur der Import-Tab deaktiviert, der Rest läuft normal:
ANTHROPIC_API_KEY=
# Modell für die Rezept-Extraktion (günstiges Haiku als Default):
RECIPE_LLM_MODEL=claude-haiku-4-5
# Optionaler Apify-Token, damit Instagram-Links beim Import automatisch
# aufgelöst werden (Caption-Scraping). Ohne ihn: Caption einfügen.
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
