NODE_ENV=production
PORT=3000
# In Docker auf das gemountete Volume zeigen lassen:
DATABASE_PATH=/data/eazio.db
# 32-Byte-Key, base64: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
MASTER_KEY=
# zufälliger String, min. 16 Zeichen: `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
SESSION_SECRET=
# Token zum einmaligen Anlegen von Nutzern (POST /api/auth/bootstrap)
ADMIN_BOOTSTRAP=
TZ=Europe/Berlin
# Hinter Nginx Proxy Manager (HTTPS) korrekt:
COOKIE_SECURE=true
YAZIO_COUNTRIES=DE
YAZIO_LOCALES=de_DE,de_US
# Docker-Netz, in dem Nginx Proxy Manager läuft (`docker network ls`):
NPM_NETWORK=npm_default
